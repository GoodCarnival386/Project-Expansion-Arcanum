{
  "ts-node": {
    "experimentalSpecifierResolution": "node"
  },
  "compilerOptions": {
    "target": "es2022",
    "strict": true,
    "outDir": "./build",
    "strictPropertyInitialization": false,
    "inlineSourceMap": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "module": "esnext"
  },
  "include": ["**/*"],
  "exclude": ["node_modules"]
}
